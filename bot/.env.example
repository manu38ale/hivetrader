# Never use the personal account. Only the dedicated bot account.
BOT_ACCOUNT=
# Set only on the server, never in VITE_* or in git.
BOT_ACTIVE_KEY=
PAPER_MODE=true
RPC_NODES=https://api.hive.blog,https://api.deathwing.me,https://api.openhive.network
POLL_INTERVAL_SEC=15
QUOTE_SIZE_PCT=0.05
MIN_SPREAD_PCT=0.01
REQUOTE_THRESHOLD_PCT=0.002
INVENTORY_TARGET_HBD_PCT=0.5
SKEW_GAIN=1.0
ORDER_EXPIRATION_MIN=60
TOXIC_MOVE_PCT=0.02
TOXIC_WINDOW_MIN=10
PAUSE_MIN=30
MAX_DAILY_LOSS_HBD=5
# Price precision is a quoting convention, not a Hive protocol price tick.
PRICE_TICK=0.000001
# Optional paper-only virtual balances; omit to use observed account balances.
# PAPER_HIVE=1000
# PAPER_HBD=100
# Persistent state, separate for paper/live automatically.
STATE_DIR=.state
BACKTEST_DAYS=30
BACKTEST_HIVE=1000
# Omit for initial inventory balanced at first trade and configured target.
# BACKTEST_HBD=100
# Hypothetical book spread: not obtainable from historical trades.
BACKTEST_SPREAD_PCT=0.012
