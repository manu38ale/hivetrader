{
  "name": "hive-internal-market-maker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "paper": "node --env-file-if-exists=.env --import tsx src/index.ts --paper",
    "test": "node --import tsx --test test/*.test.ts",
    "backtest": "node --env-file-if-exists=.env --import tsx src/backtest.ts"
  },
  "dependencies": { "@hiveio/dhive": "^1.3.2" },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.19.0", "typescript": "~5.5.3" }
}
